# SharePoint Config
SP_SITE_ID=your_site_id
SP_LIST_ID=your_list_id_1
SP_LIST_ID_2=your_list_id_2

# Auth Config
TENANT_ID=your_tenant_id
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret
GRAPH_SCOPE=https://graph.microsoft.com/.default

# Dashboard Session (JWT)
# Todas las variables de esta sección son obligatorias: la API no arranca sin ellas
# (ver presentation/api.py). No uses valores de ejemplo débiles en un entorno real.
JWT_SECRET_KEY=change_me_generate_a_long_random_secret
DASHBOARD_USER=change_me
DASHBOARD_PASSWORD=change_me_use_a_strong_password
# Nunca uses '*' aquí: la API exige orígenes explícitos porque combina CORS con credenciales.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
